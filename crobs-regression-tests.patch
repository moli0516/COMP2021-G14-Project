@@ -0,0 +1,61 @@
+"""Shared build and assertion helpers for external regression tests."""
+import argparse
+import datetime
+import json
+import re
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+MAIN = "hk.edu.polyu.comp.comp2021.crobs."
+
+def options(description):
+    parser = argparse.ArgumentParser(description=description)
+    parser.add_argument("--java", default="java")
+    parser.add_argument("--javac", default="javac")
+    parser.add_argument("--headed", action="store_true", help="Browser runner only")
+    return parser.parse_args()
+
+def prepare(args, name):
+    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
+    work = ROOT / "regression-results" / (name + "-" + stamp)
+    classes = work / "classes"
+    classes.mkdir(parents=True)
+    sources = sorted((ROOT / "src").rglob("*.java"))
+    if not sources:
+        raise RuntimeError("No Java sources found under src/")
+    argfile = work / "sources.txt"
+    argfile.write_text("\n".join('"' + p.as_posix() + '"' for p in sources), encoding="utf-8")
+    result = subprocess.run(
+        [args.javac, "-encoding", "UTF-8", "--release", "8", "-d", str(classes),
+         "@" + str(argfile)], cwd=ROOT, capture_output=True, text=True,
+        encoding="utf-8", errors="replace", timeout=120)
+    (work / "compile.stdout.txt").write_text(result.stdout, encoding="utf-8")
+    (work / "compile.stderr.txt").write_text(result.stderr, encoding="utf-8")
+    if result.returncode:
+        raise RuntimeError("Compilation failed; inspect " + str(work))
+    return work, classes
+
+def check(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+def entity(output, prefix):
+    match = re.search(r"\b" + prefix + r"\d+\b", output)
+    check(match is not None, "Missing " + prefix + " ID in: " + output)
+    return match.group()
+
+def logs(work, expected=None):
+    txt = (work / "commands.txt").read_text(encoding="utf-8")
+    html = (work / "commands.html").read_text(encoding="utf-8")
+    if expected is not None:
+        check(txt.splitlines() == expected, "TXT command log mismatch")
+    check("</html>" in html.lower(), "HTML log was not closed")
+    return txt, html
+
+def report(work, passed, error=None):
+    data = {"passed": passed, "error": error}
+    (work / "result.json").write_text(json.dumps(data, indent=2), encoding="utf-8")
+    print(("PASS" if passed else "FAIL") + ": " + str(work))
+    if error:
+        print(error)
diff --git a/tools/regression/cli_regression.py b/tools/regression/cli_regression.py
new file mode 100644
--- /dev/null
+++ b/tools/regression/cli_regression.py
@@ -0,0 +1,161 @@
+"""Compile and regression-test the real CLI; no third-party dependencies."""
+import datetime
+import queue
+import subprocess
+import threading
+import traceback
+from common import ROOT, MAIN, options, prepare, check, entity, logs, report
+
+class CLI:
+    def __init__(self, args, work, classes):
+        self.work, self.sent = work, []
+        self.events = queue.Queue()
+        self.raw = []
+        self.stderr = (work / "stderr.txt").open("w", encoding="utf-8")
+        self.proc = subprocess.Popen(
+            [args.java, "-cp", str(classes), MAIN + "Application",
+             "-html", str(work / "commands.html"), "-txt", str(work / "commands.txt")],
+            cwd=ROOT, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+            stderr=self.stderr, text=True, encoding="utf-8", errors="replace", bufsize=1)
+        threading.Thread(target=self._read, daemon=True).start()
+        self._response()
+
+    def _read(self):
+        while True:
+            char = self.proc.stdout.read(1)
+            if not char:
+                self.events.put(None)
+                return
+            self.raw.append(char)
+            self.events.put(char)
+
+    def _response(self):
+        import time
+        deadline = time.monotonic() + 15
+        value = ""
+        while True:
+            char = self.events.get(timeout=max(0.01, deadline-time.monotonic()))
+            if char is None:
+                raise RuntimeError("CLI exited unexpectedly: " + value)
+            value += char
+            if value.endswith("CROBS>> "):
+                return value[:-len("CROBS>> ")].strip()
+            if time.monotonic() >= deadline:
+                raise TimeoutError("CLI response timed out")
+
+    def command(self, line, error=False):
+        self.sent.append(line)
+        self.proc.stdin.write(line + "\n")
+        self.proc.stdin.flush()
+        output = self._response()
+        check(output.startswith("Error:") == error,
+              "Unexpected result for " + line + ": " + output)
+        return output
+
+    def finish(self, quit_command=True):
+        if quit_command:
+            self.sent.append("quit")
+            self.proc.stdin.write("quit\n")
+            self.proc.stdin.flush()
+        self.proc.stdin.close()
+        check(self.proc.wait(timeout=15) == 0, "CLI exit status was nonzero")
+        self.cleanup()
+        logs(self.work, self.sent)
+
+    def cleanup(self):
+        if self.proc.poll() is None:
+            self.proc.kill()
+            self.proc.wait(timeout=5)
+        self.stderr.close()
+        (self.work / "stdout.txt").write_text("".join(self.raw), encoding="utf-8")
+
+def workflow(c):
+    day = datetime.date.today() + datetime.timedelta(days=14)
+    d = day.isoformat()
+    c.command("listAllRooms", error=True)
+    c.command("login UNKNOWN", error=True)
+    c.command("login SA001")
+    c.command("login SA001", error=True)
+    r = entity(c.command("addRoom meetingRoom 10 projector"), "R")
+    u = entity(c.command("addUser Alice Regression"), "U")
+    other = entity(c.command("addUser Bob Regression"), "U")
+    c.command(f"modifyRoom {r} capacity 20")
+    check("capacity: 20" in c.command(f"listRoom {r}"), "Room modification not persisted")
+    c.command(f"modifyRoom {r} capacity abc", error=True)
+    check("capacity: 20" in c.command(f"listRoom {r}"), "Rejected update changed room")
+    c.command("logout")
+    c.command("login " + u)
+    c.command("addRoom meetingRoom 10 -", error=True)
+    c.command("addUser Forbidden", error=True)
+    c.command(f"modifyRoom {r} capacity 30", error=True)
+    b = entity(c.command(f"book {r} {d} 09:00 10:00 Original meeting"), "B")
+    c.command(f"book {r} {d} 09:30 10:30 Conflict", error=True)
+    adjacent = entity(c.command(f"book {r} {d} 10:00 11:00 Adjacent meeting"), "B")
+    c.command(f"modifyBooking {b} {r} {d} 10:30 11:30 Rejected change", error=True)
+    listing = c.command("listBookings")
+    original = next(line for line in listing.splitlines() if line.startswith(b + " "))
+    check("09:00-10:00 Original meeting" in original, "Failed modification changed original")
+    check(listing.index(b) < listing.index(adjacent), "Bookings not time sorted")
+    check(r not in c.command(f"search {d} 09:30 09:45 1 projector"), "Occupied room found")
+    check(r in c.command(f"search {d} 11:00 12:00 20 projector"), "Available room not found")
+    check(r not in c.command(f"search {d} 11:00 12:00 21 projector"), "Capacity filter failed")
+    check(r not in c.command(f"search {d} 11:00 12:00 1 whiteboard"), "Feature filter failed")
+    sixth = (day + datetime.timedelta(days=6)).isoformat()
+    seventh = (day + datetime.timedelta(days=7)).isoformat()
+    included = entity(c.command(f"book {r} {sixth} 09:00 10:00 Last included day"), "B")
+    excluded = entity(c.command(f"book {r} {seventh} 09:00 10:00 Outside week"), "B")
+    schedule = c.command(f"schedule {r} {d}")
+    check(b in schedule and included in schedule and excluded not in schedule, "Seven-day boundaries failed")
+    check("booked by " + u in schedule, "Owner cannot see own ID")
+    c.command("logout")
+    c.command("login " + other)
+    c.command("deleteBooking " + b, error=True)
+    c.command(f"modifyBooking {b} {r} {d} 12:00 13:00 Forbidden", error=True)
+    schedule = c.command(f"schedule {r} {d}")
+    check("booked by hidden" in schedule and u not in schedule, "Regular-user privacy failed")
+    c.command("logout")
+    c.command("login SA001")
+    check("booked by " + u in c.command(f"schedule {r} {d}"), "Admin owner visibility failed")
+    c.command("deleteBooking " + b, error=True)
+    c.command("removeUser " + u)
+    check("No bookings this week." in c.command(f"schedule {r} {d}"), "Removing user retained bookings")
+    c.command("logout")
+    c.command("login " + u, error=True)
+    c.command("login SA001")
+    c.command(f"book {r} {d} 09:00 10:00 Removed room booking")
+    c.command("deleteRoom " + r)
+    c.command("listRoom " + r, error=True)
+    check("CANCELLED" in c.command("listBookings"), "Room deletion did not cancel booking")
+    c.command("book", error=True)
+    c.command("search invalid-date 09:00 10:00 1 -", error=True)
+    c.command("notACommand <tag>&", error=True)
+
+def main():
+    args = options(__doc__)
+    work, classes = prepare(args, "cli")
+    c = None
+    try:
+        c = CLI(args, work, classes)
+        workflow(c)
+        c.finish()
+        _, html = logs(work)
+        check("&lt;tag&gt;&amp;" in html and "<tag>" not in html, "HTML escaping failed")
+        eof_dir = work / "eof"
+        eof_dir.mkdir()
+        c = CLI(args, eof_dir, classes)
+        c.command("login SA001")
+        c.finish(quit_command=False)
+        invalid = subprocess.run([args.java, "-cp", str(classes), MAIN + "Application"],
+                                 cwd=ROOT, capture_output=True, text=True, timeout=15)
+        (work / "invalid-startup.txt").write_text(invalid.stdout + invalid.stderr, encoding="utf-8")
+        check(invalid.returncode != 0 and "Usage:" in invalid.stderr, "Invalid startup accepted")
+        report(work, True)
+        return 0
+    except Exception:
+        if c is not None:
+            c.cleanup()
+        report(work, False, traceback.format_exc())
+        return 1
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/regression/browser_smoke.py b/tools/regression/browser_smoke.py
new file mode 100644
--- /dev/null
+++ b/tools/regression/browser_smoke.py
@@ -0,0 +1,144 @@
+"""Compile and smoke-test real browser forms using Playwright Chromium."""
+import datetime
+import re
+import socket
+import subprocess
+import time
+import traceback
+import urllib.request
+from common import ROOT, MAIN, options, prepare, check, entity, logs, report
+
+def main():
+    args = options(__doc__)
+    from playwright.sync_api import sync_playwright, expect
+    work, classes = prepare(args, "browser")
+    url = "http://127.0.0.1:8080"
+    with socket.socket() as probe:
+        check(probe.connect_ex(("127.0.0.1", 8080)) != 0,
+              "Port 8080 is occupied. Stop your existing CROBS server first.")
+    output = (work / "server.stdout.txt").open("w", encoding="utf-8")
+    errors = (work / "server.stderr.txt").open("w", encoding="utf-8")
+    proc = subprocess.Popen(
+        [args.java, "-cp", str(classes), MAIN + "web.WebApplication",
+         "-html", str(work / "commands.html"), "-txt", str(work / "commands.txt")],
+        cwd=ROOT, stdout=output, stderr=errors)
+    failure = None
+    try:
+        deadline = time.monotonic() + 20
+        while True:
+            check(proc.poll() is None, "Web server exited; inspect server.stderr.txt")
+            try:
+                with urllib.request.urlopen(url, timeout=1) as response:
+                    check(response.status == 200, "Homepage not available")
+                break
+            except OSError:
+                if time.monotonic() > deadline:
+                    raise TimeoutError("Web server did not become ready")
+                time.sleep(0.1)
+        with sync_playwright() as pw:
+            browser = pw.chromium.launch(headless=not args.headed)
+            context = browser.new_context()
+            context.tracing.start(screenshots=True, snapshots=True, sources=True)
+            page = context.new_page()
+            page.set_default_timeout(10000)
+            js_errors = []
+            page.on("pageerror", lambda error: js_errors.append(str(error)))
+            page.on("dialog", lambda dialog: dialog.accept())
+            try:
+                page.goto(url)
+                expect(page.locator("#section-title")).to_have_text("Session")
+
+                def section(name):
+                    page.locator("#navigation").get_by_role("button", name=name, exact=True).click()
+
+                def form(title):
+                    return page.locator("#forms form").filter(
+                        has=page.get_by_role("heading", name=title, exact=True))
+
+                def submit(section_name, title, values=None, error=False):
+                    section(section_name)
+                    target = form(title)
+                    for name, value in (values or {}).items():
+                        field = target.locator('[name="' + name + '"]')
+                        if field.evaluate("el => el.tagName") == "SELECT":
+                            field.select_option(value)
+                        else:
+                            field.fill(value)
+                    with page.expect_response(lambda response:
+                            response.url.endswith("/api/command") and
+                            response.request.method == "POST") as pending:
+                        target.get_by_role("button", name=title, exact=True).click()
+                    check(pending.value.status == 200, "Command HTTP failure")
+                    expect(target.get_by_role("button", name=title, exact=True)).to_be_enabled()
+                    text = page.locator("#output").inner_text()
+                    check(text.startswith("Error:") == error, title + ": " + text)
+                    return text
+
+                submit("Session", "Log in", {"userId": "SA001"})
+                page.get_by_role("button", name="Refresh ID options", exact=True).click()
+                expect(page.get_by_role("button", name="Refresh ID options", exact=True)).to_be_enabled()
+                expect(page.locator("#output")).to_have_text("ID options refreshed")
+                room = entity(submit("Administration", "Add room", {
+                    "roomType": "meetingRoom", "capacity": "10", "features": "projector"}), "R")
+                user = entity(submit("Administration", "Add user", {"name": "Browser User"}), "U")
+                submit("Session", "Log out")
+                submit("Session", "Log in", {"userId": user})
+                day = (datetime.date.today() + datetime.timedelta(days=14)).isoformat()
+                values = {"roomId": room, "date": day, "startTime": "09:00",
+                          "endTime": "10:00", "purpose": "Browser meeting"}
+                booking = entity(submit("Bookings", "Create booking", values), "B")
+                expect(form("Modify booking").locator('[name="bookingId"] option[value="' + booking + '"]')).to_have_count(1)
+                submit("Bookings", "Create booking", dict(values, startTime="09:30", endTime="10:30"), error=True)
+                submit("Bookings", "Modify booking", dict(values, bookingId=booking,
+                       startTime="11:00", endTime="12:00", purpose="Updated browser meeting"))
+                check("11:00-12:00 Updated browser meeting" in submit("Bookings", "My bookings"),
+                      "Modified booking missing")
+                check("Updated browser meeting" in submit("Schedule", "Weekly schedule", {
+                    "roomId": room, "weekStartDate": day}), "Schedule missing booking")
+                check(room in submit("Rooms", "Search available rooms", {
+                    "date": day, "startTime": "12:00", "endTime": "13:00",
+                    "minCapacity": "10", "features": "projector"}), "Search failed")
+                submit("Bookings", "Delete booking", {"bookingId": booking})
+                expect(form("Modify booking").locator('[name="bookingId"] option[value="' + booking + '"]')).to_have_count(0)
+                check("No bookings found." in submit("Bookings", "My bookings"), "Booking not deleted")
+                submit("Session", "Log out")
+                submit("Bookings", "My bookings", error=True)
+                # Quit disables every button, so wait for the command response/status instead.
+                section("Session")
+                with page.expect_response(lambda response: response.url.endswith("/api/command")):
+                    form("Quit application").get_by_role("button", name="Quit application", exact=True).click()
+                expect(page.locator("#status")).to_have_text(
+                    "Application stopped. Restart Java and reload this page.")
+                check(not js_errors, "Uncaught JavaScript errors: " + repr(js_errors))
+                page.screenshot(path=str(work / "final.png"), full_page=True)
+                check(proc.wait(timeout=15) == 0, "Server did not exit cleanly")
+                txt, _ = logs(work)
+                check("quit" in txt.splitlines(), "Quit command missing from log")
+            except Exception:
+                failure = traceback.format_exc()
+                try:
+                    page.screenshot(path=str(work / "failure.png"), full_page=True)
+                    (work / "failure.html").write_text(page.content(), encoding="utf-8")
+                except Exception:
+                    pass
+            finally:
+                (work / "page-errors.txt").write_text("\n".join(js_errors), encoding="utf-8")
+                context.tracing.stop(path=str(work / "trace.zip"))
+                browser.close()
+    except Exception:
+        failure = traceback.format_exc()
+    finally:
+        if proc.poll() is None:
+            proc.terminate()
+            try:
+                proc.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                proc.kill()
+                proc.wait(timeout=5)
+        output.close()
+        errors.close()
+    report(work, failure is None, failure)
+    return int(failure is not None)
+
+if __name__ == "__main__":
+    raise SystemExit(main())
